{
  "name": "react-libui",
  "description": "A react component library",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "bunup",
    "dev": "bun run --filter './apps/*' dev",
    "dev:apps": "bun run --filter './apps/*' dev",
    "dev:packages": "bun run --filter './packages/*' dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "tsc": "tsc --noEmit && bun run --filter './apps/*' tsc",
    "release": "bumpp --commit --push --tag"
  },
  "catalog": {
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "qs": "^6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "catalogs": {
    "types": {
      "@types/bun": "^1.2.23",
      "@types/lodash": "^4.17.20",
      "@types/qs": "^6.14.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0"
    },
    "peer": {
      "clsx": "^2.1.0",
      "lodash": "^4",
      "qs": "^6",
      "react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
      "react-dom": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
      "typescript": ">=4.5.0",
      "zod": "^4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "bumpp": "^10.3.1",
    "bunup": "^0.14.20",
    "lefthook": "^1.13.6",
    "lightningcss": "^1.30.2",
    "ultracite": "^5.6.2",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priossrsth/@react-lib.git"
  },
  "bugs": {
    "url": "https://github.com/priosshrsth/@react-lib/issues"
  },
  "homepage": "https://github.com/priosshrsth/@react-lib#readme",
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "dev": "^0.1.3"
  }
}
