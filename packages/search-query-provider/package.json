{
  "name": "@react-lib/search-query-provider",
  "description": "Search query provider to use with @react-lib/core/search-query",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./schemas": {
      "import": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      }
    },
    "./contexts": {
      "import": {
        "types": "./dist/contexts/index.d.ts",
        "default": "./dist/contexts/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/lodash": "catalog:types",
    "@types/qs": "catalog:types",
    "@types/react": "catalog:types",
    "lodash": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "lodash": "catalog:peer",
    "qs": "catalog:peer",
    "react": "catalog:peer",
    "react-dom": "catalog:peer",
    "typescript": "catalog:peer",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
