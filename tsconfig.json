{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@react-lib/*": ["./packages/*"]
    },
    "strictNullChecks": true
  },
  "include": ["packages/**/*", "app.d.ts"],
  "exclude": ["node_modules", "dist", "bunup.config.ts", "apps"]
}
